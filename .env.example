# ---- Phase 1 (used now) ----

# Postgres connection string used by Prisma (apps/api)
DATABASE_URL="postgresql://cardscan:cardscan@localhost:5432/cardscan?schema=public"

# Redis connection (docker-compose service; not yet wired into API logic, reserved for caching in a later phase)
REDIS_URL="redis://localhost:6379"

# API server
PORT=4100
NODE_ENV=development
# Comma-separated: web app + the Expo web build of the mobile app
CORS_ORIGIN="http://localhost:3001,http://localhost:8081"

# JWT
JWT_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Consumed by web (Next.js) and mobile (Expo) to reach the API
NEXT_PUBLIC_API_URL="http://localhost:4100/api"
EXPO_PUBLIC_API_URL="http://localhost:4100/api"
# Mobile ads and subscriptions (Android). Empty = Google test ads and no purchases.
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Pokémon card catalog (TCGdex — https://tcgdex.dev)
POKEMON_API_URL="https://api.tcgdex.net/v2/en"

# Magic: The Gathering card catalog (Scryfall — https://scryfall.com/docs/api)
MAGIC_API_URL="https://api.scryfall.com"

# Yu-Gi-Oh! card catalog (YGOPRODeck — https://ygoprodeck.com/api-guide/)
YUGIOH_API_URL="https://db.ygoprodeck.com/api/v7"

# Other catalogs (all free, no API key). Defaults are built in; set these only to point at a mirror.
# LORCANA_API_URL="https://api.lorcast.com/v0"                 # Disney Lorcana — Lorcast
# ONEPIECE_API_URL="https://optcgapi.com/api"                   # One Piece — OPTCG API
# DIGIMON_API_URL="https://digimoncard.io/api-public"           # Digimon — digimoncard.io
# STARWARS_API_URL="https://api.swu-db.com"                     # Star Wars: Unlimited — SWU-DB
# FAB_DATA_URL="https://raw.githubusercontent.com/the-fab-cube/flesh-and-blood-cards/develop/json/english"  # Flesh and Blood — fab-cube dataset

# Read the number printed on the card to tell reprints apart (OCR). Experimental, off by default.
# RECOGNITION_READ_PRINT=false

# Scans: a few to start with (once), then a rewarded ad gives every next batch. Premium has no limit.
# WELCOME_SCAN_CREDITS=5
# FREE_SCANS_PER_DAY=0            # optional extra free scans per UTC day
# REWARDED_AD_CREDITS=5
# REWARDED_ADS_PER_DAY=50
# NEXT_PUBLIC_WEB_AD_TAG_URL=          # web (apps/web/.env): the VAST ad tag; empty = no web ads
# WEB_AD_MIN_SECONDS=15             # web ads: minimum time before an ad session pays
# WEB_ADS_PER_DAY=10
# ADMOB_REWARDED_AD_UNIT_ID=          # only callbacks for this ad unit add credits
# REVENUECAT_WEBHOOK_SECRET=          # Authorization header RevenueCat sends to /api/billing/revenuecat
# Stripe (web subscriptions)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# STRIPE_PRICE_SCANS_25=            # one-off pack of 25 scans
# STRIPE_PRICE_SCANS_100=           # one-off pack of 100 scans
# WEB_PUBLIC_URL=http://localhost:3001

# Affiliate links on the card page. Empty = plain links that earn nothing.
# AFFILIATE_TCGPLAYER_URL="https://tcgplayer.pxf.io/c/<your-id>/<your-id>/<your-id>?u={url}"
# AFFILIATE_EBAY_CAMPAIGN_ID=
# AFFILIATE_CARDMARKET_URL=
# AFFILIATE_CARDTRADER_URL=

# Background sync of catalogs (weekly) and prices (daily). On by default in development only.
# AUTO_SYNC=true
# AUTO_SYNC_CATALOG_HOURS=24
# AUTO_SYNC_PRICES_HOURS=24

# TCGplayer price history for the chart (TCGplayer's own, unofficial endpoint; fetched only when a card chart is opened).
# TCGPLAYER_HISTORY=true

# TCGplayer prices (tcgcsv.com — free daily mirror of TCGplayer's price API, no key). Set only to point at a mirror.
# TCGPLAYER_PRICES_URL="https://tcgcsv.com/tcgplayer"

# Public base URL of this API, used to build links to re-hosted card images served from /assets
# (images live in apps/api/storage by default; override the folder with ASSETS_DIR)
API_PUBLIC_URL="http://localhost:4100"

# ---- Reserved for later phases (not read by any code yet) ----

# Object storage (card images, scan uploads)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Card recognition provider
# CARD_RECOGNITION_PROVIDER=
# CARD_RECOGNITION_API_KEY=

# Price provider
# PRICE_PROVIDER=
# PRICE_PROVIDER_API_KEY=
