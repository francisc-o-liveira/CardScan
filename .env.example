# ---- Phase 1 (used now) ----

# Postgres connection string used by Prisma (apps/api)
DATABASE_URL="postgresql://cardscan:cardscan@localhost:5432/cardscan?schema=public"

# Redis connection (docker-compose service; not yet wired into API logic, reserved for caching in a later phase)
REDIS_URL="redis://localhost:6379"

# API server
PORT=4100
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Consumed by web (Next.js) and mobile (Expo) to reach the API
NEXT_PUBLIC_API_URL="http://localhost:4100/api"
EXPO_PUBLIC_API_URL="http://localhost:4100/api"

# ---- Reserved for later phases (not read by any code yet) ----

# Object storage (card images, scan uploads)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# External TCG data providers
# POKEMON_API_URL=
# MAGIC_API_URL=

# Card recognition provider
# CARD_RECOGNITION_PROVIDER=
# CARD_RECOGNITION_API_KEY=

# Price provider
# PRICE_PROVIDER=
# PRICE_PROVIDER_API_KEY=
