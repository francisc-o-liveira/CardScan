{
  "name": "@cardscan/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "sync:pokemon": "tsx src/scripts/syncPokemon.ts",
    "sync:magic": "tsx src/scripts/syncMagic.ts",
    "sync:yugioh": "tsx src/scripts/syncYugioh.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:lorcana": "tsx src/scripts/syncCatalog.ts lorcana",
    "sync:onepiece": "tsx src/scripts/syncCatalog.ts onepiece",
    "sync:digimon": "tsx src/scripts/syncCatalog.ts digimon",
    "sync:starwars": "tsx src/scripts/syncCatalog.ts starwars",
    "sync:fab": "tsx src/scripts/syncCatalog.ts fab",
    "sync:others": "tsx src/scripts/syncCatalog.ts all"
  },
  "dependencies": {
    "@cardscan/config": "workspace:*",
    "@cardscan/types": "workspace:*",
    "@cardscan/validation": "workspace:*",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "supertest": "^7.2.2",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
