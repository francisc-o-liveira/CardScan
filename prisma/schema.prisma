// CardScan — core database schema (Phase 1: full schema, only User/Auth wired into the API so far)

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

enum Language {
  EN
  PT
  JA
  ES
  FR
  DE
  IT
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  avatarUrl       String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  collection           Collection?
  wishlist             Wishlist?
  scans                Scan[]
  decks                Deck[]

  @@map("users")
}

/// Supports multiple concurrent sessions (web + mobile) per user.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// TCG catalog
// ---------------------------------------------------------------------------

model Tcg {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  sets  CardSet[]
  cards Card[]
  decks Deck[]

  @@map("tcgs")
}

model CardSet {
  id          String    @id @default(uuid())
  tcgId       String
  code        String
  name        String
  releaseDate DateTime?
  totalCards  Int?
  symbolUrl   String?
  createdAt   DateTime  @default(now())

  tcg   Tcg    @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([tcgId, code])
  @@map("sets")
}

model Card {
  id              String   @id @default(uuid())
  tcgId           String
  setId           String
  name            String
  collectorNumber String
  rarity          String?
  variant         String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tcg  Tcg     @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  set  CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  variants            CardVariant[]
  collectionItems     CollectionItem[]
  wishlistItems       WishlistItem[]
  deckItems           DeckItem[]
  scans               Scan[]              @relation("ScanSelectedCard")
  predictedInFeedback RecognitionFeedback[] @relation("PredictedCard")
  actualInFeedback    RecognitionFeedback[] @relation("ActualCard")
  prices              Price[]
  priceHistory        PriceHistory[]

  @@unique([tcgId, setId, collectorNumber, variant])
  @@index([name])
  @@map("cards")
}

model CardVariant {
  id       String   @id @default(uuid())
  cardId   String
  language Language @default(EN)
  name     String
  imageUrl String?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, language, name])
  @@map("card_variants")
}

// ---------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------

model Collection {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id            String        @id @default(uuid())
  collectionId  String
  cardId        String
  quantity      Int           @default(1)
  condition     CardCondition @default(NM)
  language      Language      @default(EN)
  variant       String?
  notes         String?
  purchasePrice Decimal?      @db.Decimal(10, 2)
  purchaseDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([collectionId, cardId, condition, language, variant])
  @@map("collection_items")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id          String   @id @default(uuid())
  wishlistId  String
  cardId      String
  priority    Int      @default(0)
  targetPrice Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, cardId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Scanning
// ---------------------------------------------------------------------------

model Scan {
  id              String     @id @default(uuid())
  userId          String
  imageUrl        String
  status          ScanStatus @default(PENDING)
  result          Json?
  confidence      Float?
  selectedCardId  String?
  createdAt       DateTime   @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCard Card?                 @relation("ScanSelectedCard", fields: [selectedCardId], references: [id])
  feedback     RecognitionFeedback[]

  @@index([userId, createdAt])
  @@map("scans")
}

/// Captures user corrections to recognition results, forming a dataset for future model improvements.
model RecognitionFeedback {
  id               String   @id @default(uuid())
  scanId           String
  predictedCardId  String?
  actualCardId     String?
  confidence       Float?
  createdAt        DateTime @default(now())

  scan          Scan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  predictedCard Card? @relation("PredictedCard", fields: [predictedCardId], references: [id])
  actualCard    Card? @relation("ActualCard", fields: [actualCardId], references: [id])

  @@map("recognition_feedback")
}

// ---------------------------------------------------------------------------
// Decks
// ---------------------------------------------------------------------------

model Deck {
  id        String   @id @default(uuid())
  userId    String
  tcgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tcg   Tcg        @relation(fields: [tcgId], references: [id])
  items DeckItem[]

  @@map("decks")
}

model DeckItem {
  id       String @id @default(uuid())
  deckId   String
  cardId   String
  quantity Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@map("deck_items")
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

/// Current best-known price snapshot per (card, source, finish).
///
/// `subType` is the source's finish/printing label — TCGplayer prices "Normal",
/// "Holofoil", "Reverse Holofoil", "1st Edition" … separately — and "" when the
/// source has a single price per card. `externalId` is the source's product id
/// (TCGplayer productId), used to link to the listing.
model Price {
  id         String   @id @default(uuid())
  cardId     String
  source     String
  subType    String   @default("")
  low        Decimal? @db.Decimal(10, 2)
  average    Decimal? @db.Decimal(10, 2)
  high       Decimal? @db.Decimal(10, 2)
  market     Decimal? @db.Decimal(10, 2)
  currency   String   @default("EUR")
  externalId String?
  updatedAt  DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, source, subType])
  @@map("prices")
}

model PriceHistory {
  id         String   @id @default(uuid())
  cardId     String
  source     String
  subType    String   @default("")
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("EUR")
  recordedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, recordedAt])
  @@map("price_history")
}
